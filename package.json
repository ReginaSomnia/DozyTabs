{
	"name": "dozy-tabs",
	"description": "Puts idle YouTube tabs to sleep to free memory and CPU",
	"private": true,
	"version": "1.1.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox --mv3",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox --mv3",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox --mv3",
		"release": "node scripts/release.mjs",
		"typecheck": "tsc --noEmit && tsc -p e2e",
		"test": "vitest run",
		"test:e2e": "node e2e/run.mjs chrome",
		"test:e2e:firefox": "node e2e/run.mjs firefox",
		"e2e:install": "node e2e/run.mjs install",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"postinstall": "wxt prepare"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@types/node": "^26.6.5",
		"prettier": "^3.9.9",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"wxt": "^0.21.4"
	}
}
